# Supabase - obtain from the project's Connect panel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# OpenAI - server only
OPENAI_API_KEY=
OPENAI_AUDIT_MODEL=gpt-5-mini

# Transactional email - server only
# Used for founding-customer requests and Ava lead notifications.
RESEND_API_KEY=
AVA_LEAD_NOTIFICATION_EMAIL=colecollins763@gmail.com
# From address for Ava checkout, onboarding, and lead mail.
# Bare address or "Ava <ava@yourdomain.com>". Defaults to onboarding@resend.dev (Resend test sender).
AVA_FROM_EMAIL=

# Optional Twilio SMS lead alerts (additive to Resend email) - server only
# When all four are set, POST /api/ava/leads and Sales qualify notify also SMS AVA_LEAD_SMS_TO.
# Missing any value no-ops SMS cleanly; email remains primary. Do not commit secrets.
# Numbers must be E.164 (e.g. +15551234567). Not Google SMS — Twilio only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AVA_LEAD_SMS_TO=

# Ava/ElevenLabs - server only
# ELEVENLABS_AGENT_ID remains the customer-duplication template and fallback demo agent.
# Optional demo voice agents fall back to ELEVENLABS_AGENT_ID when unset.
# ELEVENLABS_SALES_AGENT_ID is a SEPARATE Sales Ava qualify agent (do not reuse the template).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_ID_SOUTHERN_MAN=
ELEVENLABS_AGENT_ID_SOUTHERN_WOMAN=
ELEVENLABS_AGENT_ID_AMERICAN_WOMAN=
ELEVENLABS_SALES_AGENT_ID=
# Long random bearer secret for POST /api/ava/provision.
AVA_PROVISIONING_SECRET=
# Opt in only after the template agent and onboarding flow have been tested.
AVA_AUTO_PROVISION_AGENT=false
# HMAC secret for POST /api/webhooks/elevenlabs (ElevenLabs post-call webhook, header ElevenLabs-Signature).
ELEVENLABS_WEBHOOK_SECRET=

# Optional public booking link for setup calls (Cal.com / Google appointment URL).
# No calendar API is called — link is shown after Sales Ava qualify when set.
NEXT_PUBLIC_AVA_SETUP_BOOKING_URL=

# Optional HMAC secret for short-lived Sales Ava prefill tokens (staff contact GET).
# Falls back to AVA_PROVISIONING_SECRET, then SUPABASE_SECRET_KEY.
AVA_QUALIFY_PREFILL_SECRET=

# Stripe checkout - server only
# Creates Checkout Sessions for the founding plan ($99/month, subscription only)
# and Ava plans ($79 / $149 / $299 per month, 7-day trial). Without this key, checkout cannot start.
STRIPE_SECRET_KEY=
# Webhook signing secret for POST /api/webhooks/stripe (Dashboard → Webhooks → whsec_...).
# Required. The route verifies the signature, upserts Ava customers, and sends onboarding mail.
STRIPE_WEBHOOK_SECRET=
# Optional Dashboard price IDs. When unset, checkout uses inline price_data
# and sets the product name in code (YardProof Founding Plan / Ava Receptionist – <plan>).
# If you set Dashboard price IDs, recreate them for the new Ava amounts ($79 / $149 / $299).
# STRIPE_FOUNDING_MONTHLY_PRICE_ID=
# STRIPE_AVA_STARTER_PRICE_ID=
# STRIPE_AVA_GROWTH_PRICE_ID=
# STRIPE_AVA_PRO_PRICE_ID=
# Only needed to auto-provision submissions from an Ava-specific Payment Link.
AVA_STRIPE_PAYMENT_LINK_ID=

# Public application URL (local app origin; not used for canonicals)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public site origin for metadataBase, canonicals, sitemap, robots, and Open Graph.
# No trailing slash. When unset, the site uses https://frontporchgrowth.com.
NEXT_PUBLIC_SITE_URL=https://frontporchgrowth.com

# Cold / prospect email. Default off. Leave unset or false and nothing is sent.
# Resend is transactional mail only (founding requests, Ava checkout, lead alerts).
# It is not a Lead Finder transport.
COLD_EMAIL_ENABLED=false
# Pluggable transport: stub (default), smtp, or instantly. All three are unwired and do not send.
# COLD_EMAIL_TRANSPORT=stub

# Ava pilot Stripe payment link (legacy pilot path — keep Ava-specific; never reuse Visual Canvasser links)
NEXT_PUBLIC_AVA_PILOT_PAYMENT_LINK=

# --- YardProof / postcard imagery (NOT live until keys + Storage + migrations) ---
# Server-only. Never add a NEXT_PUBLIC_GOOGLE_MAPS_* variant: the key must not reach the browser.
# Imagery uses Geocoding + Street View Static + Maps Static.
# Lead Finder also uses this key for Geocoding and Places API (New) Text Search.
# Enable those APIs on the key. The app never buys Maps products or enables billing.
# Street View / satellite bytes are downloaded server-side and served from private Storage.
# Product: Street View Static = printable Current + AI After input (download into Storage).
# Crew/owner photos remain optional alternate Current sources. Human review before mail.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_URL_SIGNING_SECRET=
# After-render model override (default gpt-image-1; gpt-image-* always return base64 — do not send response_format)
OPENAI_IMAGE_MODEL=
# Optional Gemini/Imagen path for photoreal after-edits (server-only)
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=
IMAGERY_PROVIDER=openai
AFTER_PROMPT_VERSION=demo10-multitrade-v1
IMAGERY_STORAGE_BUCKET=yardproof-imagery
IMAGERY_DAILY_CAP=50
# Optional server-only Demo Blast 10 payment link.
# When unset or invalid, CTAs fall back to a request email to Cole.
DEMO10_PAYMENT_LINK=

# Lead Finder unsubscribe links (server only).
# Optional. When unset, links are signed with SUPABASE_SECRET_KEY (or SUPABASE_SERVICE_ROLE_KEY).
# Sending is blocked until one of those secrets exists, so every email can include a working unsubscribe URL.
# PROSPECTOR_UNSUBSCRIBE_SECRET=
