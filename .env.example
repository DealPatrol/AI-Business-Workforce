# Supabase - obtain from the project's Connect panel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# OpenAI - server only
OPENAI_API_KEY=
OPENAI_AUDIT_MODEL=gpt-5-mini

# Transactional email - server only
# Used for founding-customer requests and Ava lead notifications.
RESEND_API_KEY=
AVA_LEAD_NOTIFICATION_EMAIL=colecollins763@gmail.com

# Ava/ElevenLabs - server only
# ELEVENLABS_AGENT_ID is the template used by the browser demo and customer duplication.
# ELEVENLABS_SALES_AGENT_ID is a SEPARATE Sales Ava qualify agent (do not reuse the template).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_SALES_AGENT_ID=
# Long random bearer secret for POST /api/ava/provision.
AVA_PROVISIONING_SECRET=
# Opt in only after the template agent and onboarding flow have been tested.
AVA_AUTO_PROVISION_AGENT=false

# Optional public booking link for setup calls (Cal.com / Google appointment URL).
# No calendar API is called — link is shown after Sales Ava qualify when set.
NEXT_PUBLIC_AVA_SETUP_BOOKING_URL=

# Stripe checkout - server only
STRIPE_SECRET_KEY=
# Only needed to auto-provision submissions from an Ava-specific Payment Link.
AVA_STRIPE_PAYMENT_LINK_ID=

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ava pilot Stripe payment link (legacy pilot path — keep Ava-specific; never reuse Visual Canvasser links)
NEXT_PUBLIC_AVA_PILOT_PAYMENT_LINK=
